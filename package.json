{
  "name": "@epubjs-react-native/expo-file-system",
  "version": "2.0.0",
  "description": "An expo file system module for epubjs-react-native library",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist/",
    "copy-files:cjs": "copyfiles -u 1 src/**/*.json dist/cjs",
    "copy-files:esm": "copyfiles -u 1 src/**/*.json dist/esm",
    "build:cjs": "tsc -p config/tsconfig.cjs.json --skipLibCheck",
    "build:esm": "tsc -p config/tsconfig.esm.json --skipLibCheck",
    "build:types": "tsc -p config/tsconfig.types.json --skipLibCheck",
    "style:format": "biome format --write ./src",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "test": "jest --no-cache --runInBand --passWithNoTests",
    "test:coverage": "jest --coverage --no-cache --runInBand --passWithNoTests",
    "type-check": "tsc --pretty --noEmit --skipLibCheck --esModuleInterop --resolveJsonModule",
    "package": "npm run build && npm pack",
    "prebuild": "npm run clean",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "postbuild": "npm run copy-files:cjs && npm run copy-files:esm",
    "prerelease": "npm run lint:fix && npm run type-check && npm run test:coverage",
    "release": "npm run build && npm publish",
    "release-local": "npm run build && npm link && echo [FINISH]: Run \"npm link @epubjs-react-native/expo-file-system\" to link the package to your project"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "epubjs-react-native",
    "expo",
    "file-system",
    "fs"
  ],
  "repository": {
    "url": "git+https://github.com/victorsoares96/epubjs-react-native-expo-file-system.git"
  },
  "author": "Victor Soares <vitorsoares96@hotmail.com> (https://github.com/victorsoares96)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/victorsoares96/epubjs-react-native-expo-file-system/issues"
  },
  "homepage": "https://github.com/victorsoares96/epubjs-react-native-expo-file-system#readme",
  "peerDependencies": {
    "expo-file-system": ">=54.0.0",
    "react": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "commitizen": "4.3.1",
    "commitizen-emoji": "1.0.5",
    "copyfiles": "2.4.1",
    "expo-file-system": "57.0.6",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "15.4.3",
    "react": "19.2.8",
    "rimraf": "6.0.1",
    "ts-jest": "29.2.6",
    "typescript": "5.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/commitizen-emoji"
    },
    "commitizenEmoji": {
      "conventionalFormat": true
    }
  }
}
